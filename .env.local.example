# ══════════════════════════════════════════════════════════════════════════════
# Environment Variables — copy this file to .env.local and fill in the values.
# Never commit .env.local to git.
# ══════════════════════════════════════════════════════════════════════════════


# ─── GitHub Blog Source ───────────────────────────────────────────────────────
#
# Blog posts are pulled from a private GitHub repo.
# When these vars are absent, the site falls back to local content/blog/ files.
#
# Setup:
#   1. Create a private repo on GitHub (e.g. "yourusername/teacher-blog-content")
#   2. Add locale subfolders: en/ vi/ zh/ ru/
#   3. GitHub → Settings → Developer settings → Personal access tokens
#      → Fine-grained tokens → New token
#      → Repository access: only your blog repo
#      → Permissions → Repository permissions → Contents: Read-only
#      → Generate token
#
GITHUB_TOKEN="github_pat_xxxxxxxxxxxx"

# Your blog repo in "owner/repo" format
GITHUB_BLOG_REPO="yourusername/teacher-blog-content"

# How long (seconds) to cache GitHub responses. Default: 3600 (1 hour).
# Set to 60 during testing so new posts appear quickly.
BLOG_CACHE_REVALIDATE_SECONDS=3600


# ─── Cache Revalidation Webhook ──────────────────────────────────────────────
#
# Used by POST /api/revalidate to bust the blog cache on demand.
# Generate a secure random value:  openssl rand -hex 32
#
# Call it after pushing a new post to GitHub:
#   curl -X POST https://your-domain.com/api/revalidate \
#        -H "Authorization: Bearer YOUR_SECRET_HERE"
#
REVALIDATE_SECRET="replace-with-a-long-random-secret"


# ─── Contact Form ────────────────────────────────────────────────────────────
#
# CONTACT_EMAIL="bek@yourdomain.com"
# RESEND_API_KEY="re_xxxxxxxxxxxx"


# ─── Google Analytics ────────────────────────────────────────────────────────
#
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
