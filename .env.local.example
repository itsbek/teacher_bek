# ══════════════════════════════════════════════════════════════════════════════
# Environment Variables — copy this file to .env.local and fill in the values.
# Never commit .env.local to git.
# ══════════════════════════════════════════════════════════════════════════════


# ─── Contact Form / Leads ────────────────────────────────────────────────────
#
# Everything below is optional. Each feature switches on only when its
# variables are set. Step-by-step guide: docs/setup/leads-setup.md
#
# Leads go to Google Sheets and Telegram only (no email). RESEND_API_KEY and
# CONTACT_NOTIFY_EMAIL are no longer used by the lead pipeline; the owner may
# delete them from Vercel.

# Google Sheet storage (Apps Script web app, see docs/setup/google-apps-script.gs)
LEADS_SHEET_WEBHOOK_URL=
LEADS_SHEET_SECRET=

# Telegram bot (notifications + lead management)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=

# Cloudflare Turnstile (spam protection). The site key renders the widget; the server only
# verifies when the secret is set. Set both together.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics: Plausible (script is hard-coded in app/[locale]/layout.tsx; no env vars needed).

# ─── Error monitoring: Sentry (errors only). Everything is a no-op while the DSNs are empty. ───
# Setup note: docs/v4/sentry.md
# Browser DSN (public; loaded lazily after the page is idle) and server DSN (route handlers + lead delivery alerts).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Optional, only for uploading source maps at build (Vercel build env). Without a token nothing is uploaded.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
