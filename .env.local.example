# ══════════════════════════════════════════════════════════════════════════════
# Environment Variables — copy this file to .env.local and fill in the values.
# Never commit .env.local to git.
# ══════════════════════════════════════════════════════════════════════════════


# ─── Google Drive Blog Source ────────────────────────────────────────────────
#
# When all three GOOGLE_DRIVE_* variables are set, blog posts are fetched from
# Google Drive instead of the local content/blog/ folder.
# When they are absent, the site falls back to local markdown files (ideal for
# development without credentials).
#
# Setup guide:
#   1. Go to https://console.cloud.google.com
#   2. Create a project → Enable "Google Drive API"
#   3. IAM & Admin → Service Accounts → Create service account
#   4. Keys → Add Key → JSON → download the file
#   5. In Google Drive, create a folder called "teacher-blog"
#      with subfolders: en/ vi/ zh/ ru/
#   6. Share that folder with the service account email (Viewer role)
#   7. Copy the folder ID from the Drive URL:
#      https://drive.google.com/drive/folders/THIS_IS_THE_FOLDER_ID
#
GOOGLE_DRIVE_CLIENT_EMAIL="service-account@your-project.iam.gserviceaccount.com"

# The private_key field from the downloaded JSON file.
# Paste the full value including -----BEGIN/END PRIVATE KEY-----.
# On most platforms (Vercel/Railway) you can paste multi-line values directly.
# If using a .env.local file, replace real newlines with \n.
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# The ID of the root "teacher-blog" Drive folder (not a subfolder).
GOOGLE_DRIVE_BLOG_FOLDER_ID="1A2B3C4D5E6F7G8H9I0J"

# How long (seconds) to cache Drive responses. Default: 3600 (1 hour).
# Set to 60 during testing so changes appear quickly.
BLOG_CACHE_REVALIDATE_SECONDS=3600


# ─── Cache Revalidation Webhook ──────────────────────────────────────────────
#
# Used by POST /api/revalidate to bust the blog cache on demand.
# Generate a secure random value:  openssl rand -hex 32
#
# Call it after saving a post in Drive:
#   curl -X POST https://your-domain.com/api/revalidate \
#        -H "Authorization: Bearer YOUR_SECRET_HERE"
#
REVALIDATE_SECRET="replace-with-a-long-random-secret"


# ─── Contact Form ────────────────────────────────────────────────────────────
#
# Where contact form submissions are emailed.
#
# CONTACT_EMAIL="bek@yourdomain.com"
# RESEND_API_KEY="re_xxxxxxxxxxxx"


# ─── Google Analytics ────────────────────────────────────────────────────────
#
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
