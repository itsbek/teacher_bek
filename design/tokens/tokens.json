{
  "$description": "teacherbek.com design tokens. Mirror of tokens.css (CSS is the source of truth). Values are CSS strings.",
  "color": {
    "light": {
      "paper": "#F5F0E6", "paper-2": "#ECE4D4", "ink": "#15130F", "ink-soft": "#5E584D",
      "red-pen": "#C52019", "highlight": "#F2DC4B", "chalk-green": "#22392D", "rule": "#15130F1F",
      "on-red-pen": "#FFFFFF"
    },
    "dark": {
      "paper": "#14201A", "paper-2": "#1C2B23", "ink": "#EEE9DD", "ink-soft": "#B8B2A4",
      "red-pen": "#FF6A5C", "highlight": "#E5CE3E", "chalk-green": "#22392D", "rule": "#EEE9DD26",
      "on-red-pen": "#14201A"
    },
    "chapter-chalk": { "bg": "#22392D", "fg": "#EEE9DD", "fg-soft": "#B8B2A4", "accent": "#FF7366" },
    "semantic": {
      "bg": "paper", "bg-2": "paper-2", "fg": "ink", "fg-soft": "ink-soft", "accent": "red-pen",
      "highlight": "highlight", "rule": "rule", "chapter-chalk": "chalk-green", "focus": "red-pen"
    }
  },
  "font": {
    "display": "\"Playfair\", \"Playfair Fallback\", \"Songti SC\", Georgia, \"Times New Roman\", serif",
    "text": "\"Inter\", \"Inter Fallback\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
    "cjk-display": "\"Songti SC\", \"Noto Serif CJK SC\", \"Source Han Serif SC\", serif",
    "cjk-text": "\"PingFang SC\", \"Noto Sans CJK SC\", \"Source Han Sans SC\", \"Microsoft YaHei\", sans-serif"
  },
  "type": {
    "display-xl": { "size": "clamp(64px, 14vw, 220px)", "lh": 0.9, "lh-vi": 1.02, "lh-zh": 1.25, "tracking": "-0.03em", "weight": 500, "variation": "\"opsz\" 1200, \"wght\" 500" },
    "display-l":  { "size": "clamp(44px, 8vw, 128px)",  "lh": 0.95, "lh-vi": 1.06, "lh-zh": 1.3,  "tracking": "-0.02em", "weight": 500, "variation": "\"opsz\" 400, \"wght\" 500" },
    "display-m":  { "size": "clamp(32px, 5vw, 72px)",   "lh": 1.1,  "lh-vi": 1.18, "lh-zh": 1.35, "tracking": "-0.015em", "weight": 500, "variation": "\"opsz\" 72, \"wght\" 500" },
    "accent":     { "style": "italic", "weight": 400, "variation": "normal", "note": "static italic instance (opsz 72, wght 400); reveal = clip-path write, no axis animation" },
    "title":      { "size": "clamp(22px, 2.4vw, 32px)", "lh": 1.25, "tracking": "-0.01em", "weight": 600 },
    "body-l":     { "size": "clamp(18px, 1.4vw, 22px)", "lh": 1.55, "weight": 400 },
    "body":       { "size": "17px", "size-md": "18px", "lh": 1.6, "lh-vi": 1.65, "lh-zh": 1.7, "weight": 400 },
    "label":      { "size": "13px", "size-md": "14px", "weight": 600, "tracking-en": "0.04em", "transform-en": "uppercase", "tracking-other": "0", "transform-other": "none" },
    "num":        { "feature": "font-variant-numeric: tabular-nums lining-nums" }
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "6": "24px", "8": "32px", "12": "48px", "16": "64px", "24": "96px", "32": "128px", "48": "192px", "section": "clamp(80px, 12vw, 192px)", "section-quiet": "clamp(64px, 8vw, 128px)" },
  "grid": { "cols-mobile": 4, "cols-desktop": 12, "gutter-mobile": "16px", "gutter-desktop": "24px", "margin": "clamp(20px, 5vw, 80px)", "max-width": "1440px", "breakpoint-md": "768px", "margin-line": "start of column 2 (desktop), 12px from container edge (mobile)" },
  "border": { "radius": "0", "hair": "1px", "pen": "1.5px", "strong": "2px", "shadow": "none" },
  "motion": {
    "ease-out": "cubic-bezier(0.22, 1, 0.36, 1)",
    "ease-in-out": "cubic-bezier(0.65, 0, 0.35, 1)",
    "ease-pen": "cubic-bezier(0.45, 0.05, 0.25, 1)",
    "dur-tap": "120ms", "dur-ui": "240ms", "dur-image": "600ms", "dur-reveal": "800ms",
    "dur-settle": "700ms", "dur-stroke-min": "400ms", "dur-stroke-max": "1100ms", "stroke-speed-px-per-ms": 1.2,
    "stagger-lines": "80ms", "stagger-items": "60ms", "sequence-max": "900ms"
  },
  "z": { "base": 0, "grain": 1, "margin-line": 2, "raised": 10, "sticky": 100, "header": 200, "sheet": 300, "cursor": 400, "toast": 500, "skip-link": 1000 },
  "focus": { "width": "3px", "offset": "3px", "color": "red-pen" },
  "size": { "tap-min": "44px", "btn-h": "56px", "btn-h-desktop": "52px", "input-h": "52px", "input-font": "17px", "sticky-bar-h": "64px" },
  "tier": { "attribute": "html[data-tier]", "values": ["full", "touch", "lite"] }
}
